# Secrets — never commit these
.env
*.pem
*.key

# Rust
/target/
# Cargo.lock is tracked on purpose. This crate is not a library — it ships a
# binary — so the exact resolved versions are part of what gets deployed, and
# CI and Docker should both build the set that was actually tested.

# Data dir (self-hosted repos cache / pi sessions)
/data/

# OS / editor
.DS_Store
.idea/
.vscode/
