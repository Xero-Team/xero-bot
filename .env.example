# ---- GitHub App (fill these in) ----
# Numeric App ID from your GitHub App's "General" settings page.
APP_ID=
# Path to the App's private key (.pem) you downloaded. Keep this file secret.
PRIVATE_KEY_PATH=./xero-review-bot.pem
# The webhook secret you set when creating the App.
WEBHOOK_SECRET=
# The @-name of your bot (the App's username without the [bot] suffix is fine).
BOT_NAME=xero-review

# ---- AI provider (fill these in — your own endpoint / key / model) ----
# API base URL WITHOUT a trailing slash. Examples:
#   OpenAI:        https://api.openai.com/v1
#   a proxy:       https://your-proxy.example.com/v1
#   Anthropic:     https://api.anthropic.com   (code appends /v1/messages)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Which request format to use:  chat  |  responses  |  anthropic
#   chat       -> POST {AI_BASE_URL}/chat/completions   (OpenAI Chat Completions)
#   responses  -> POST {AI_BASE_URL}/responses          (OpenAI Responses API)
#   anthropic  -> POST {AI_BASE_URL}/v1/messages        (Anthropic Messages API)
API_FORMAT=chat

# ---- Service ----
# Local port the HTTP server listens on. Expose this to the public internet
# over HTTPS (Tailscale Funnel, Cloudflare Tunnel, reverse proxy, VPS, ...).
PORT=8080
# Diffs larger than this (in chars) are truncated to bound token cost.
MAX_DIFF_CHARS=60000
