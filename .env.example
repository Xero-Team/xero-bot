# ============================================================================
# xero-bot 配置文件模板
# ----------------------------------------------------------------------------
# 用法: cp .env.example .env  然后把 .env 里每一项填好。
# 注意:
#   1. .env 已被 .gitignore 忽略,真实密钥只放 .env,不要提交到仓库!
#   2. 若进程环境变量里已有同名变量(如 docker compose 的 environment:),
#      环境变量优先,.env 里的值会被忽略。
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
# 一、GitHub App 凭据(必填,两种部署方式都要)
# ────────────────────────────────────────────────────────────────────────────
# App 的数字 ID。位置: GitHub → Settings → Developer settings → GitHub Apps
#   → 点你的 App → General 页面最上方的 "App ID"(例如 1234567)。
APP_ID=

# App 私钥的两种给法,二选一:
#   方式 A(推荐,通用): 把下载的 .pem 文件内容转成 base64 填到 PRIVATE_KEY_B64。
#     生成命令(在 .pem 文件所在目录执行):
#       Linux / Git Bash:   base64 -w0 xxxxx.pem
#       macOS:              base64 -i xxxxx.pem
#     输出一整行字符串,直接粘贴到下面,Vercel 和 Docker 都能用。
#   方式 B(仅自托管): 保持 PRIVATE_KEY_PATH 指向 .pem 文件路径,
#     并在 docker-compose.yml 里把文件挂载进容器(见 README 部署章节)。
# 私钥位置: App 设置页 General → 底部 "Private keys" → Generate a private key
#   (会自动下载一个 .pem 文件,只能下载一次,丢了就重新生成)。
# PRIVATE_KEY_B64 优先级高于 PRIVATE_KEY_PATH。用方式 B 时把它整行注释掉,
# 别留成空值 —— 空值也算"已设置",容易让人误判到底哪个生效了。
#PRIVATE_KEY_B64=
PRIVATE_KEY_PATH=./xero-review-bot.pem

# 创建 App 时你自己设置的 Webhook secret(一串随机字符串)。
# 必须与 App 设置页 "Webhook secret" 完全一致,否则 GitHub 推送会被 401 拒绝。
# 生成一个随机串的例子:  openssl rand -hex 20
WEBHOOK_SECRET=

# bot 的名字(不带 [bot] 后缀)。即 GitHub App 的名称本身,
# 例如 App 叫 "xero-review",这里就填 xero-review。
# 用户在 PR 评论里 @ 的就是这个名字。
BOT_NAME=xero-review

# App 自身的 login(不带 [bot] 后缀),用于识别"哪些评论/审查是我自己发的"。
# 留空 = 启动后通过 GET /app 自动获取并在进程内缓存,通常无需设置。
# Vercel 建议显式设置:serverless 每次调用都是新进程,缓存永远是冷的,
# 设了它就能省掉这次 API 往返。
# 取值 = App 设置页 URL 里的那一段(通常与 BOT_NAME 相同)。
APP_SLUG=


# ────────────────────────────────────────────────────────────────────────────
# 二、AI 服务(agent / builtin 引擎用;pi/codex 引擎不用这些)
# ────────────────────────────────────────────────────────────────────────────
# API 地址,结尾不要带斜杠。三种常见填法:
#   OpenAI 官方:      https://api.openai.com/v1
#   第三方中转/代理:   https://your-proxy.example.com/v1
#   Anthropic 官方:   https://api.anthropic.com   (代码会自动补 /v1/messages)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 请求格式,三选一,必须与你的 API 服务匹配:
#   chat       -> POST {AI_BASE_URL}/chat/completions   (OpenAI Chat Completions 兼容,最常见)
#   responses  -> POST {AI_BASE_URL}/responses          (OpenAI 新版 Responses API)
#   anthropic  -> POST {AI_BASE_URL}/v1/messages        (Anthropic Messages API)
# builtin 和 agent 两个引擎都按这里的设置发请求(agent 的工具调用也会用对应协议的格式),
# 所以中转服务只提供其中一种端点时,两个引擎的行为是一致的 —— 不会一个能用一个不能用。
API_FORMAT=chat

# 上面三项填好后,自托管服务启动时会自动发一次一次性的探测请求(约 1 行日志),
# 用来确认"密钥有效 + 端点存在 + 返回格式与 API_FORMAT 一致"。日志形如:
#   INFO AI check — API_FORMAT=responses: ok (200 OK) [https://…/v1/responses]
#   WARN AI check FAILED — API_FORMAT=anthropic: HTTP 404 … Invalid URL (POST /v1/v1/messages)
# 探测失败只是 WARN,不会阻止启动 —— r+/标签/rebase 这些不用 AI 的命令照常工作。
# 三项没填齐则跳过探测(视为"这个部署不用 AI",不是错误)。
# 注意: Vercel 是 serverless,没有启动时机,不会执行这次探测。


# ────────────────────────────────────────────────────────────────────────────
# 三、审查引擎选择
# ────────────────────────────────────────────────────────────────────────────
# auto                自动探测: pi 装了用 pi → codex 装了用 codex → agent → builtin
# builtin             单次 HTTP 调用(用上面第二节的 AI 配置),Vercel/Docker 均可用
# agent               工具调用循环(模型先浏览仓库再审查),Vercel/Docker 均可用
# pi                  子进程 pi CLI,仅自托管/Docker(容器内已预装)
# codex               子进程 codex CLI,仅自托管/Docker(容器内已预装)
# 说明:
#   - Vercel 上 pi/codex 不可用(无法跑子进程),auto 会自动落到 agent。
#   - pi 引擎需要 pi 自己的 API key(容器内设 OPENAI_API_KEY 环境变量,
#     或挂载 ~/.pi 目录);codex 引擎同理需要 OPENAI_API_KEY。
REVIEW_ENGINE=auto

# agent 引擎的预算(只在 REVIEW_ENGINE=agent 或 auto 落到 agent 时生效):
# 最多几轮工具调用 / 整体超时秒数(超时自动回退 builtin)。
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_SECS=240


# ────────────────────────────────────────────────────────────────────────────
# 四、子进程引擎(仅自托管/Docker,Vercel 忽略)
# ────────────────────────────────────────────────────────────────────────────
# pi / codex CLI 自己的 AI 密钥(与第二节的 AI_API_KEY 无关)。
# Docker 部署:直接写在 .env 里即可,compose 的 env_file 会自动注入容器。
# 裸机部署: export OPENAI_API_KEY=... 后再启动服务。
# 不填也行 —— 引擎自动探测会跳过 pi/codex,回退到 agent 引擎,bot 照常工作。
OPENAI_API_KEY=

# CLI 可执行文件路径。容器内已预装,保持默认即可。
# 自托管裸机部署时,先 npm install -g @mariozechner/pi-coding-agent @openai/codex
# 再按需修改路径。
PI_PATH=pi
PI_ARGS=
CODEX_PATH=codex
CODEX_ARGS=

# 工作数据目录: 缓存仓库 checkout 和 pi 会话(跨轮审查的"项目记忆")。
# Docker 部署保持 /data(对应具名卷 xero-data,不要改,否则丢增量记忆);
# 裸机部署可改为任意可写目录。删除该目录 = 丢失所有缓存,审查退化为首轮。
# 目录结构:
#   {XERO_DATA_DIR}/repos/{owner}__{repo}/pr-{编号}   每个 PR 一份 checkout
#   {XERO_DATA_DIR}/sessions/{owner}__{repo}          pi 会话,按仓库共享(增量记忆)
#   {XERO_DATA_DIR}/codex/{owner}__{repo}-pr{编号}-{sha}.md   codex 单轮输出,读完即删
# checkout 按 PR 而非按仓库分开是必须的:工作树停在某个 PR 的 head 上,共用一份会让
# 并发的两轮审查读到对方的代码。磁盘占用因此约为「同时活跃的 PR 数 × 浅克隆大小」;
# 需要回收时可以安全删除 repos/ 下已合并 PR 的目录(sessions/ 不要删)。
XERO_DATA_DIR=/data

# 审查 checkout 抓取多少层历史(浅克隆深度,默认 100)。
# 需要深到 PR 与目标分支存在共同祖先 —— 否则 `git diff 目标分支...HEAD` 没有左端,
# 模型看到的是整个分支而不是这次改动。不够深时会自动 --deepen=200 再试一次,
# 仍不够就带着现有历史继续审查(只记一条 WARN),不会为此付一次全量克隆的代价。
# 组织里普遍存在长期分支时可以调大;想省磁盘和带宽可以调小。
CHECKOUT_DEPTH=100


# ────────────────────────────────────────────────────────────────────────────
# 五、服务
# ────────────────────────────────────────────────────────────────────────────
# HTTP 监听端口。Docker 部署保持 8080(compose 已映射 8080:8080)。
PORT=8080

# diff 超过这么多**字节**会被截断,控制单次审查的 token 成本。
# (名字里的 CHARS 是历史遗留;判断与截断都按字节,且只在 UTF-8 字符边界上切。)
MAX_DIFF_CHARS=60000


# ────────────────────────────────────────────────────────────────────────────
# 六、命令权限
# ────────────────────────────────────────────────────────────────────────────
# 是否允许 `@bot r+ as @其他人` 把批准归功于第三方。**默认 false,建议保持关闭。**
#
# 由 App 提交的 APPROVE review 是一次真实批准,要求 1 个批准的分支保护规则会计入它。
# 开启后,任何 write 权限持有者都能以同事的名义凭空制造一个批准、满足必需审查规则,
# 而该同事根本没看过这个 PR —— 批准会带着他的用户名,却没有任何记录表明他并未给出。
# 仅在你们确实需要"把其他渠道(会议/IM)给出的批准转发到 PR 上"时才开启;开启后
# 被归功者仍必须具备 write 及以上权限。
#
# 普通 `r+`(归功于评论者本人,而他本来就需要 write 权限)不受此开关影响,始终可用。
# 无论开关如何,PR 作者都不能让 bot 批准自己的 PR。
R_PLUS_ALLOW_ON_BEHALF=false


# ────────────────────────────────────────────────────────────────────────────
# 七、定时任务 / rebase 巡检
# ────────────────────────────────────────────────────────────────────────────
# 定时触发的密钥。用法:
#   Vercel:  **必填**。填一个随机串,Vercel Cron 会自动带上 Bearer 头。
#            留空时 /api/cron 直接返回 500 —— 此前会退化为只看 User-Agent,
#            而 UA 可以随意伪造,而巡检会遍历所有安装并可能发提醒评论。
#   Docker:  内置循环默认已开启(见下),不需要外部 cron;
#            若想额外手动触发: curl -H "Authorization: Bearer <CRON_SECRET>" http://localhost:8080/cron
#            留空 = /cron 不鉴权。注意服务器绑定 0.0.0.0,所以"只监听内网"需靠
#            防火墙实现;留空时启动日志会有一条 WARN 提醒。
# 生成: openssl rand -hex 20
CRON_SECRET=

# 收到 push 事件后等多少秒再检查冲突(GitHub 异步计算 mergeable,立刻查会查不到)。
REBASE_CHECK_DELAY_SECS=10

# 自托管内置巡检循环: 是否开启 / 间隔秒数(默认 21600 = 6 小时一轮,
# 扫描所有已安装仓库的 open PR,兜底补检 push 事件漏掉的冲突)。
REBASE_SWEEP_ENABLED=true
REBASE_SWEEP_INTERVAL_SECS=21600


# ────────────────────────────────────────────────────────────────────────────
# 八、标签(一般保持默认;只有当你们组织已有同名冲突标签时才需要改)
# ────────────────────────────────────────────────────────────────────────────
# 冲突提醒标签 / 三个互斥的工作流状态标签。
LABEL_NEEDS_REBASE=needs-rebase
LABEL_WAITING_REVIEW=waiting-on-review
LABEL_WAITING_AUTHOR=waiting-on-author
LABEL_BLOCKED=blocked

# 填一个标签名(如 codeql)后,给 PR 打这个标签会自动触发 CodeQL 报告;
# 留空(默认)= 只能用 "@bot codeql" 命令手动触发。
CODEQL_LABEL=
