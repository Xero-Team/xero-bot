# ---- GitHub App (fill these in) ----
# Numeric App ID from your GitHub App's "General" settings page.
APP_ID=
# Path to the App's private key (.pem) — self-hosted mode.
# On Vercel use PRIVATE_KEY_B64 instead (base64 of the .pem file contents).
PRIVATE_KEY_PATH=./xero-review-bot.pem
# The webhook secret you set when creating the App.
WEBHOOK_SECRET=
# The @-name of your bot (the App's username without the [bot] suffix is fine).
BOT_NAME=xero-review

# ---- AI provider (builtin / agent engines; fill these in) ----
# API base URL WITHOUT a trailing slash. Examples:
#   OpenAI:        https://api.openai.com/v1
#   a proxy:       https://your-proxy.example.com/v1
#   Anthropic:     https://api.anthropic.com   (code appends /v1/messages)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Which request format to use:  chat  |  responses  |  anthropic
API_FORMAT=chat

# ---- Review engine ----
# auto  -> pi (if installed) -> codex (if installed) -> agent -> builtin
# builtin / agent / pi / codex  -> force a specific engine
#   agent & builtin: pure HTTP, work on Vercel
#   pi & codex: subprocess CLIs, self-hosted/Docker only
REVIEW_ENGINE=auto
# agent engine budget
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_SECS=240

# ---- Subprocess engines (self-hosted / Docker only) ----
PI_PATH=pi
PI_ARGS=
CODEX_PATH=codex
CODEX_ARGS=
# Where repo checkouts and pi sessions are cached (persistent volume!)
XERO_DATA_DIR=/data

# ---- Service ----
PORT=8080
# Diffs larger than this (in chars) are truncated to bound token cost.
MAX_DIFF_CHARS=60000

# ---- Cron / rebase sweep ----
# Vercel injects this as `Authorization: Bearer $CRON_SECRET` on cron hits.
CRON_SECRET=
# Delay before checking mergeable after a push (GitHub computes it async).
REBASE_CHECK_DELAY_SECS=10
# Self-hosted sweep loop.
REBASE_SWEEP_ENABLED=true
REBASE_SWEEP_INTERVAL_SECS=21600

# ---- Labels ----
LABEL_NEEDS_REBASE=needs-rebase
LABEL_WAITING_REVIEW=waiting-on-review
LABEL_WAITING_AUTHOR=waiting-on-author
LABEL_BLOCKED=blocked
# Non-empty = posting this label on a PR triggers a CodeQL report.
# Leave empty to disable the label trigger (the @bot codeql command always works).
CODEQL_LABEL=
